# Copy to .env. Everything is optional; the demo runs with no keys at all.

# Database. Default is a local SQLite file. docker compose exposes Postgres on 5432.
# DATABASE_URL=postgresql+psycopg://sherlock:sherlock@localhost:5432/sherlock
DATABASE_URL=sqlite:///./sherlock.db

# LLM. With no key, sherlock serves llm_cache/ and falls back to the deterministic stub.
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
LLM_CACHE_DIR=llm_cache

# Google Document AI (optional). Both must be set for the DocAI parser to activate.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# DOCAI_PROCESSOR_NAME=projects/<p>/locations/<l>/processors/<id>

# Where datasets live and where the UI finds the API.
DATA_DIR=data
SHERLOCK_API_URL=http://127.0.0.1:8000
